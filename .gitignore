# Timestamped reruns are local by default. The audited canonical outputs below
# are versioned in v6_lite/output and v6_lite/visualization/output.
v6_lite/visualization/output_*/
!v6_lite/visualization/output_v6_2_b2_latest_20260930/
v6_lite/visualization/continuum_focus_v6_lite_*/

# V6.1-B full A/B reruns are about 275 MB and are reproducible from the
# committed reports.  Keep raw traces and per-scenario monitor copies local;
# the audited aggregate JSON/plots in output/v6_1_b remain versioned.
v6_lite/output/v6_1_b/baseline_root/
v6_lite/output/v6_1_b/enabled_root/

# V6.2-A.1 native replay traces and probes stay local. Curated JSON reports
# and small counterexample fixtures are force-added explicitly to Git.
v6_lite/output/v6_2_a1/*/

# Immutable V6.2-B.1 experiment runs and release bundles are local artifacts.
v6_lite/output/runs/
v6_lite/output/releases/
v6_lite/output/v6_2_b2/runs/

# Local dependency download cache is not an experiment result.
v6_4/output/environment/cuda_range_download_01/*.whl
v6_4/output/environment/cuda_range_download_01/chunk_*.bin
v6_4/output/environment/cuda_range_download_01/parts/
v6_4/output/environment/cuda_range_download_01/chunks/

# Local render smoke checks; formal media are under the dated B.2 viewer.
v6_4/visualization/residual_smoke_*/

# B.3 full physical evidence is local; a curated release is published separately.
v6_4/output/conditional_route_value_*/
